FROM python:3.10

WORKDIR /app

ENV PYTHONUNBUFFERED=1

# Copy and install dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy backend code
COPY fastapi_service/core /app/core
COPY fastapi_service/routes /app/routes
COPY fastapi_service/services /app/services

# Copy frontend assets
COPY fastapi_service/templates /app/templates
COPY fastapi_service/static /app/static

# Copy .env from project root
COPY .env /app/.env

# Copy main entry point
COPY fastapi_service/main.py /app/main.py

EXPOSE 8000

CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
